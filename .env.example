# Postgres
POSTGRES_USER=hostel_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hostel_allocation
DATABASE_URL=postgresql+asyncpg://hostel_admin:hostel_pass_123@db:5432/hostel_allocation

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change_this_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Payments - SIMULATED for now (no real gateway wired up). Set SIMULATED_PAYMENTS=false
# and add real Razorpay (or other gateway) keys/config once the project is accepted.
SIMULATED_PAYMENTS=true
HOSTEL_FEE_AMOUNT_INR=60000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reservation TTL (minutes) - how long a slot is held awaiting payment
RESERVATION_TTL_MINUTES=15
